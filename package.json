{
  "name": "cc-suricata",
  "version": "0.1.0",
  "description": "Claude Code Watcher: all your Claude Code sessions on one local page, with a notification when one finishes or asks you something",
  "type": "module",
  "bin": {
    "cc-suricata": "server.mjs"
  },
  "files": [
    "server.mjs",
    "index.html",
    "icon.svg",
    "notify.ps1"
  ],
  "scripts": {
    "start": "node server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mabuenox/cc-suricata.git"
  },
  "keywords": [
    "claude-code",
    "claude",
    "sessions",
    "dashboard",
    "watcher"
  ],
  "author": "mabuenox",
  "license": "MIT"
}
